<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Reads where the HyperXR app installed its runtime library. -->
    <queries>
        <package android:name="com.hyperxr" />
    </queries>

    <application
        android:allowBackup="false"
        android:label="HyperXR OpenXR Broker"
        android:hasCode="true">
        <!-- The OpenXR loader's installable runtime broker (asked before the system broker, which
             some phones already declare). Conflicts only with the Khronos "OpenXR Runtime Broker"
             app: with that one installed, pick "HyperXR Runtime" in it instead. -->
        <provider
            android:name=".SystemBrokerProvider"
            android:authorities="org.khronos.openxr.runtime_broker"
            android:exported="true"
            tools:ignore="ExportedContentProvider" />
    </application>
</manifest>
