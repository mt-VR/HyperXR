<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Reads where the HyperXR app installed its runtime library. -->
    <queries>
        <package android:name="com.hyperxr" />
    </queries>

    <application
        android:allowBackup="false"
        android:label="HyperXR OpenXR Broker"
        android:hasCode="true">
        <!-- The OpenXR loader's system runtime broker. If installing this APK fails with a
             conflict, the phone already has an OpenXR broker: pick "HyperXR Runtime" there. -->
        <provider
            android:name=".SystemBrokerProvider"
            android:authorities="org.khronos.openxr.system_runtime_broker"
            android:exported="true"
            tools:ignore="ExportedContentProvider" />
    </application>
</manifest>
